{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downloader",
  "version": "0.1.0",
  "identifier": "com.rafa.downloader",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Downloader",
        "width": 1000,
        "height": 650,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}